{
  "name": "orbit-nest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop companions powered by Orbit",
  "main": "dist/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts test --error-on-warnings",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "npm run build && playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "core:verify": "node scripts/verify-core.mjs",
    "core:verify-installed": "node scripts/verify-core.mjs --installed"
  },
  "dependencies": {
    "@cybergarage/orbit": "file:vendor/orbit-core-230e08849f50.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.7",
    "electron": "44.5.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
